{
  "schema": "https://ai-atoms.com/schemas/tool-v1.json",
  "type": "tool",
  "id": "tool/git-show",
  "version": "1.0.0",
  "name": "git-show",
  "description": "Detail for a single commit — message, files, diff.",
  "subtype": "command",
  "spec": {
    "function_name": "git_show",
    "summary": "Return the detail of a commit.",
    "parameters": {
      "sha": {
        "type": "string",
        "description": "Commit SHA or ref",
        "required": true
      }
    },
    "returns": {
      "type": "object",
      "description": "Commit detail with diff."
    },
    "side_effects": [
      "fs-read",
      "exec"
    ]
  },
