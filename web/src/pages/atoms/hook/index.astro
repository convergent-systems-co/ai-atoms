---
import catalog from "../../../../public/exports/catalog.json";

const hooks = (catalog.atoms as any[])
  .filter(a => a.type === "hook")
  .sort((a, b) => (a.name ?? a.id).localeCompare(b.name ?? b.id));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${hooks.length} hook atoms — event-driven AI runtime behaviors for Claude Code, Copilot CLI, and agentic pipelines.`} />
    <title>Hooks · ai-atoms</title>
    <link rel="icon" type="image/svg+xml" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/favicon.svg" />
    <link rel="preconnect" href="https://brand-atoms.com" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/css/tokens.css" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/ui/atoms-catalog.css" />
    <style>
      body { min-height: 100vh; }
      .sidenav-wordmark { width: 140px; object-fit: contain; display: block; }
      .atom-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .atom-card {
        color-scheme: light;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: #ffffff;
        color: #1e293b;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
      }
      .atom-card code {
        background: #e8edf5 !important;
        color: #1e3a5f !important;
        padding: 0.1rem 0.35rem;
        border-radius: 0.25rem;
        font-size: 0.85em;
      }
      .atom-card-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
      }
      .atom-name {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
        color: #0f172a;
      }
      .atom-lifecycle {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #16a34a;
        white-space: nowrap;
      }
      .atom-description {
        color: #475569;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0;
      }
      .hook-meta-grid {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.35rem 1rem;
        font-size: 0.8rem;
      }
      .hook-meta-label {
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        padding-top: 0.1rem;
      }
      .hook-meta-value {
        color: #1e293b;
      }
      .blocking-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.1rem 0.5rem;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .blocking-yes {
        background: #fef2f2;
        color: #dc2626;
      }
      .blocking-no {
        background: #f0fdf4;
        color: #16a34a;
      }
      .side-effects-list {
        margin: 0;
        padding-left: 1.25rem;
        font-size: 0.8rem;
        color: #64748b;
      }
      .atom-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        align-items: center;
      }
      .tag {
        font-size: 0.7rem;
        background: #f1f5f9;
        color: #64748b;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
      }
      .atom-id {
        font-size: 0.75rem;
        color: #94a3b8;
        font-family: monospace;
      }
      .trigger-pattern {
        font-family: monospace;
        font-size: 0.8rem;
        background: #f8fafc;
        color: #334155;
        padding: 0.1rem 0.35rem;
        border-radius: 0.2rem;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <main class="content">
        <p style="margin-bottom: 0.5rem;"><a href="/">← ai-atoms</a></p>
        <h1>Hooks <span style="font-weight: 400; color: #475569; font-size: 1.25rem;">({hooks.length})</span></h1>
        <p style="color: #475569; max-width: 44rem; font-size: 1rem; line-height: 1.6;">
          Event-driven behaviors wired into AI tool infrastructure. Each hook declares the event it
          responds to (e.g. <code>PreToolUse</code>, <code>SessionStart</code>), its trigger pattern,
          the script language, and whether it blocks execution.
        </p>

        <div class="atom-grid">
          {hooks.map((hook: any) => (
            <div class="atom-card">
              <div class="atom-card-header">
                <h2 class="atom-name">{hook.name}</h2>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  {hook.blocking !== undefined && (
                    <span class={`blocking-badge ${hook.blocking ? 'blocking-yes' : 'blocking-no'}`}>
                      {hook.blocking ? 'blocking' : 'non-blocking'}
                    </span>
                  )}
                  {hook.lifecycle && (
                    <span class="atom-lifecycle">{hook.lifecycle}</span>
                  )}
                </div>
              </div>

              <p class="atom-description">{hook.description}</p>

              <div class="hook-meta-grid">
                <span class="hook-meta-label">Event</span>
                <span class="hook-meta-value"><code>{hook.event}</code></span>

                {hook.language && (
                  <>
                    <span class="hook-meta-label">Language</span>
                    <span class="hook-meta-value"><code>{hook.language}</code></span>
                  </>
                )}

                {hook.trigger && (
                  <>
                    <span class="hook-meta-label">Trigger</span>
                    <span class="hook-meta-value">
                      <code>{hook.trigger.type}</code>
                      {hook.trigger.pattern && (
                        <span> — <span class="trigger-pattern">{hook.trigger.pattern}</span></span>
                      )}
                    </span>
                  </>
                )}

                {hook.side_effects?.length > 0 && (
                  <>
                    <span class="hook-meta-label">Side effects</span>
                    <span class="hook-meta-value">
                      <ul class="side-effects-list">
                        {hook.side_effects.map((e: string) => <li>{e}</li>)}
                      </ul>
                    </span>
                  </>
                )}
              </div>

              {hook.tags?.length > 0 && (
                <div class="atom-meta">
                  {hook.tags.map((t: string) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              )}

              <span class="atom-id">{hook.id} · v{hook.version}</span>
            </div>
          ))}
        </div>
      </main>

      <nav class="sidenav">
        <a class="brand" href="/">
          <img src="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/atom-family-wordmark.png" alt="ATOMS" class="sidenav-wordmark" />
        </a>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/atoms/skill/">Skills</a></li>
          <li><a href="/atoms/hook/" aria-current="page">Hooks</a></li>
          <li><a href="/ai/index.json">AI</a></li>
          <li><a href="/builder/">Builder</a></li>
          <li><a href="https://github.com/convergent-systems-co/ai-atoms">GitHub ↗</a></li>
        </ul>
        <div class="aside-meta">
          <a class="meta-link" href="https://github.com/convergent-systems-co/ai-atoms">github ↗</a>
        </div>
      </nav>
    </div>
  </body>
</html>
