---
import Site from "../../../layouts/Site.astro";
import Listing from "../../../components/Listing.astro";
import { atomsOf, CLASS_META } from "../../../lib/catalog";
const atoms = atomsOf("hook");
---
<Site title={CLASS_META["hook"].plural} description={`${atoms.length} hook atoms — ${CLASS_META["hook"].blurb}`} current="/atoms/hook/">
  <Listing cls="hook" atoms={atoms} intro={'Event-driven behaviours wired into AI tool infrastructure. Each hook declares the event it responds to, its trigger, and whether it blocks. The script ships inside the atom; <code>ai hooks install</code> materialises and wires it.'} facetLabel='Event' />
</Site>
