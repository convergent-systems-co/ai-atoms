---
import Site from "../../../layouts/Site.astro";
import ActionRail from "../../../components/ActionRail.astro";
import Provenance from "../../../components/Provenance.astro";
import CategoryChip from "../../../components/CategoryChip.astro";
import { ATOMS, BY_ID, hrefOf, slugOf } from "../../../lib/catalog";

export function getStaticPaths() {
  return ATOMS.filter((a: any) => a.type === "hook").map((a: any) => ({ params: { slug: slugOf(a.id) }, props: { hook: a } }));
}
const { hook } = Astro.props;
const slug = slugOf(hook.id);
const ext: Record<string, string> = { python: "py", bash: "sh", javascript: "js", typescript: "ts" };
const scriptName = `${slug}.${ext[hook.language] ?? "txt"}`;
const deps = (hook.depends_on ?? []).map((id: string) => BY_ID.get(id)).filter(Boolean);
const usedBy = ATOMS.filter((a: any) => (a.type === "agent" && a.hooks?.includes(hook.id)) || (a.type === "hook" && a.depends_on?.includes(hook.id)));
---
<Site title={hook.name} description={hook.description} current="/atoms/hook/">
  <div class="detail hue-hook">
    <article>
      <a class="small muted" href="/atoms/hook/">← Hooks</a>
      <div class="detail-hero" style="margin-top:0.8rem;">
        <div class="chips"><span class="chip cls">Hk hook</span><CategoryChip category={hook.category} />{hook.blocking !== undefined && <span class={`chip ${hook.blocking ? "danger" : "ok"}`}>{hook.blocking ? "blocking" : "advisory"}</span>}{hook.lifecycle && <span class={`lifecycle ${hook.lifecycle}`}>{hook.lifecycle}</span>}</div>
        <h1>{hook.name}</h1>
        <p class="lede">{hook.description}</p>
        <div class="idline"><span>id <b>{hook.id}</b></span><span>v<b>{hook.version}</b></span>{hook.authored_by && <span>by <b>{hook.authored_by}</b></span>}</div>
      </div>

      <dl class="kv-table">
        <dt>Event</dt><dd><code>{hook.event || "— (library)"}</code></dd>
        {hook.trigger && <><dt>Trigger</dt><dd><code>{hook.trigger.type}</code>{hook.trigger.pattern && <> — <code>{hook.trigger.pattern}</code></>}</dd></>}
        {hook.language && <><dt>Language</dt><dd><code>{hook.language}</code></dd></>}
        {hook.side_effects?.length > 0 && <><dt>Side effects</dt><dd><ul class="list" style="padding-left:1rem;">{hook.side_effects.map((e: string) => <li>{e}</li>)}</ul></dd></>}
        {hook.platforms?.length > 0 && <><dt>Platforms</dt><dd>{hook.platforms.map((p: string) => <code style="margin-right:0.3rem;">{p}</code>)}</dd></>}
        {hook.platform_notes && <><dt>Notes</dt><dd>{hook.platform_notes}</dd></>}
        {hook.requires_wrap && <><dt>Full coverage</dt><dd>{hook.requires_wrap.description} <code>{hook.requires_wrap.install_hint}</code></dd></>}
        {deps.length > 0 && <><dt>Depends on</dt><dd>{deps.map((d: any) => <a class="ref" href={hrefOf(d.id)} style="margin-right:0.6rem;">{d.id}</a>)}</dd></>}
      </dl>

      {hook.script ? <><h2 class="h-section">Script · {scriptName}</h2><pre style="max-width:60rem;"><code>{hook.script}</code></pre></> : <p class="empty">This hook ships no script and cannot be installed until one is added.</p>}

      {usedBy.length > 0 && <><h2 class="h-section">Used by</h2><ul class="list">{usedBy.map((a: any) => <li><a class="ref" href={hrefOf(a.id)}>{a.id}</a> — {a.name}</li>)}</ul></>}
      {hook.tags?.length > 0 && <div class="chips" style="margin-top:1.2rem;">{hook.tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
      <Provenance atom={hook} />
    </article>
    <ActionRail atom={hook} text={hook.script} textFilename={scriptName} install={`ai hooks install ${slug}`} commands={[["wire in settings.json", `ai hooks run ${slug}`]]} />
  </div>
</Site>
