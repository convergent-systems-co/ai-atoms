---
import Site from "../../../layouts/Site.astro";
import Listing from "../../../components/Listing.astro";
import { atomsOf, CLASS_META } from "../../../lib/catalog";
const atoms = atomsOf("skill");
---
<Site title={CLASS_META["skill"].plural} description={`${atoms.length} skill atoms — ${CLASS_META["skill"].blurb}`} current="/atoms/skill/">
  <Listing cls="skill" atoms={atoms} intro={'Bounded, invocable units of AI capability. The <code>system_prompt_fragment</code> is the text injected into the agent when the skill loads. Copy it as <code>SKILL.md</code> into <code>.claude/skills/</code>, or install by id with the <code>ai</code> CLI.'}  />
</Site>
