---
import catalog from "../../../../public/exports/catalog.json";

const skills = (catalog.atoms as any[])
  .filter(a => a.type === "skill")
  .sort((a, b) => (a.name ?? a.id).localeCompare(b.name ?? b.id));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${skills.length} skill atoms — bounded AI behavior protocols with system-prompt fragments and invocation contracts.`} />
    <title>Skills · ai-atoms</title>
    <link rel="icon" type="image/svg+xml" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/favicon.svg" />
    <link rel="preconnect" href="https://brand-atoms.com" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/css/tokens.css" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/ui/atoms-catalog.css" />
    <style>
      body { min-height: 100vh; }
      .sidenav-wordmark { width: 140px; object-fit: contain; display: block; }
      .atom-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      /* Cards always render light regardless of the dark shell */
      .atom-card {
        color-scheme: light;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: #ffffff;
        color: #1e293b;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
      }
      /* Override atoms-catalog.css dark-mode code styling inside cards */
      .atom-card code {
        background: #e8edf5 !important;
        color: #1e3a5f !important;
        padding: 0.1rem 0.35rem;
        border-radius: 0.25rem;
        font-size: 0.85em;
      }
      .atom-card-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
      }
      .atom-name {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
        color: #0f172a;
      }
      .atom-lifecycle {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #16a34a;
        white-space: nowrap;
      }
      .atom-description {
        color: #475569;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0;
      }
      .atom-prompt {
        background: #f1f5f9;
        border-left: 3px solid #4f46e5;
        padding: 0.625rem 0.875rem;
        font-size: 0.8rem;
        line-height: 1.55;
        color: #1e293b;
        border-radius: 0 0.25rem 0.25rem 0;
        white-space: pre-wrap;
        word-break: break-word;
      }
      .invocation-block {
        background: #0f172a;
        border-radius: 0.375rem;
        padding: 0.625rem 0.875rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }
      .invocation-main {
        font-family: monospace;
        font-size: 0.85rem;
        color: #a5f3fc;
        font-weight: 600;
      }
      .invocation-sub {
        font-family: monospace;
        font-size: 0.78rem;
        color: #64748b;
        padding-left: 0.75rem;
      }
      .atom-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        align-items: center;
      }
      .tag {
        font-size: 0.7rem;
        background: #f1f5f9;
        color: #64748b;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
      }
      .atom-id {
        font-size: 0.75rem;
        color: #94a3b8;
        font-family: monospace;
      }
      .contract-section {
        font-size: 0.8rem;
      }
      .contract-section h4 {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        margin: 0 0 0.25rem;
      }
      .contract-row {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
        align-items: baseline;
      }
      .contract-field {
        font-weight: 600;
        min-width: 5rem;
        font-size: 0.75rem;
        color: #334155;
      }
      .contract-desc {
        color: #64748b;
        font-size: 0.75rem;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <main class="content">
        <p style="margin-bottom: 0.5rem;"><a href="/">← ai-atoms</a></p>
        <h1>Skills <span style="font-weight: 400; color: #64748b; font-size: 1.25rem;">({skills.length})</span></h1>
        <p style="color: #64748b; max-width: 44rem; font-size: 1rem; line-height: 1.6;">
          Bounded, invocable units of AI capability. Each skill declares a <code>system_prompt_fragment</code>
          — the instruction text injected into the agent when the skill loads — plus inputs, outputs,
          and applicable domains.
        </p>

        <div class="atom-grid">
          {skills.map((skill: any) => (
            <div class="atom-card">
              <div class="atom-card-header">
                <h2 class="atom-name">{skill.name}</h2>
                {skill.lifecycle && (
                  <span class="atom-lifecycle">{skill.lifecycle}</span>
                )}
              </div>

              <p class="atom-description">{skill.description}</p>

              {skill.invocation?.length > 0 && (
                <div class="invocation-block">
                  <span class="invocation-main">{skill.invocation[0]}</span>
                  {skill.invocation.slice(1).map((v: string) => (
                    <span class="invocation-sub">{v}</span>
                  ))}
                </div>
              )}

              {skill.system_prompt_fragment && (
                <div>
                  <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.375rem;">
                    System prompt fragment
                  </div>
                  <div class="atom-prompt">{skill.system_prompt_fragment}</div>
                </div>
              )}

              {skill.invocation_contract && (
                <div class="contract-section">
                  {skill.invocation_contract.inputs?.length > 0 && (
                    <div style="margin-bottom: 0.5rem;">
                      <h4>Inputs</h4>
                      {skill.invocation_contract.inputs.map((inp: any) => (
                        <div class="contract-row">
                          <span class="contract-field">
                            {inp.name}{inp.required ? '' : ' ?'}
                          </span>
                          <span class="contract-desc">{inp.description}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {skill.invocation_contract.outputs?.length > 0 && (
                    <div>
                      <h4>Outputs</h4>
                      {skill.invocation_contract.outputs.map((out: any) => (
                        <div class="contract-row">
                          <span class="contract-field">{out.name}</span>
                          <span class="contract-desc">{out.description}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

              <div class="atom-meta">
                {skill.applicable_domains?.map((d: string) => (
                  <span class="tag">{d}</span>
                ))}
                {skill.tags?.filter((t: string) => !skill.applicable_domains?.includes(t)).map((t: string) => (
                  <span class="tag" style="opacity: 0.7;">{t}</span>
                ))}
              </div>

              <span class="atom-id">{skill.id} · v{skill.version}</span>
            </div>
          ))}
        </div>
      </main>

      <nav class="sidenav">
        <a class="brand" href="/">
          <img src="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/atom-family-wordmark.png" alt="ATOMS" class="sidenav-wordmark" />
        </a>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/atoms/skill/" aria-current="page">Skills</a></li>
          <li><a href="/atoms/hook/">Hooks</a></li>
          <li><a href="/ai/index.json">AI</a></li>
          <li><a href="https://schema-atoms.com">Builder ↗</a></li>
          <li><a href="https://github.com/convergent-systems-co/ai-atoms">GitHub ↗</a></li>
        </ul>
        <div class="aside-meta">
          <a class="meta-link" href="https://github.com/convergent-systems-co/ai-atoms">github ↗</a>
        </div>
      </nav>
    </div>
  </body>
</html>
