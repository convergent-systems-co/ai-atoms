---
import { marked } from "marked";
import Site from "../../../layouts/Site.astro";
import ActionRail from "../../../components/ActionRail.astro";
import Provenance from "../../../components/Provenance.astro";
import CategoryChip from "../../../components/CategoryChip.astro";
import { ATOMS, BY_ID, hrefOf, slugOf } from "../../../lib/catalog";

export function getStaticPaths() {
  return ATOMS.filter((a: any) => a.type === "skill").map((a: any) => ({ params: { slug: slugOf(a.id) }, props: { skill: a } }));
}
const { skill } = Astro.props;
const slug = slugOf(skill.id);
const promptHtml = marked.parse(skill.system_prompt_fragment);
const skillMd = `---\nname: ${slug}\ndescription: ${JSON.stringify(skill.description)}\n---\n\n${skill.system_prompt_fragment}\n`;
const usedBy = ATOMS.filter((a: any) => a.type === "agent" && a.skills?.includes(skill.id));
const subSkills = (skill.depends_on ?? []).map((id: string) => BY_ID.get(id)).filter(Boolean);
const contract = skill.invocation_contract;
---
<Site title={skill.name} description={skill.description} current="/atoms/skill/">
  <div class="detail hue-skill">
    <article>
      <a class="small muted" href="/atoms/skill/">← Skills</a>
      <div class="detail-hero" style="margin-top:0.8rem;">
        <div class="chips"><span class="chip cls">Sk skill</span><CategoryChip category={skill.category} />{skill.lifecycle && <span class={`lifecycle ${skill.lifecycle}`}>{skill.lifecycle}</span>}</div>
        <h1>{skill.name}</h1>
        <p class="lede">{skill.description}</p>
        <div class="idline"><span>id <b>{skill.id}</b></span><span>v<b>{skill.version}</b></span>{skill.authored_by && <span>by <b>{skill.authored_by}</b></span>}{skill.invocation?.[0] && <span>invoke <b>{skill.invocation.join("  ")}</b></span>}</div>
      </div>

      {(skill.applicable_domains?.length || skill.tags?.length) && (
        <div class="chips">{skill.applicable_domains?.map((d: string) => <span class="tag">{d}</span>)}{skill.tags?.filter((t: string) => !skill.applicable_domains?.includes(t)).map((t: string) => <span class="tag">{t}</span>)}</div>
      )}

      {contract && (contract.inputs?.length || contract.outputs?.length) && <>
        <h2 class="h-section">Contract</h2>
        <div class="scroll"><table class="table" style="max-width:56rem;">
          <thead><tr><th>Direction</th><th>Name</th><th>Type</th><th>Description</th></tr></thead>
          <tbody>
            {contract.inputs?.map((i: any) => <tr><td>in</td><td><code>{i.name}</code>{!i.required && <span class="tag" style="margin-left:0.3rem;">optional</span>}</td><td><code>{i.type}</code></td><td>{i.description}</td></tr>)}
            {contract.outputs?.map((o: any) => <tr><td>out</td><td><code>{o.name}</code></td><td><code>{o.type}</code></td><td>{o.description}</td></tr>)}
          </tbody>
        </table></div>
        {contract.side_effects?.length > 0 && <ul class="list" style="margin-top:0.6rem;">{contract.side_effects.map((e: string) => <li>{e}</li>)}</ul>}
      </>}

      <h2 class="h-section">System prompt fragment</h2>
      <div class="prose" set:html={promptHtml} />

      {(subSkills.length || usedBy.length) > 0 && <>
        <h2 class="h-section">Related</h2>
        <ul class="list">
          {subSkills.map((s: any) => <li>installs <a class="ref" href={hrefOf(s.id)}>{s.id}</a> — {s.name}</li>)}
          {usedBy.map((a: any) => <li>bound by <a class="ref" href={hrefOf(a.id)}>{a.id}</a> — {a.name}</li>)}
        </ul>
      </>}
      <Provenance atom={skill} />
    </article>
    <ActionRail atom={skill} text={skillMd} textFilename="SKILL.md" install={`ai skills install ${slug}`}>
      <div class="panel">
        <h4>Manual install</h4>
        <ol class="list small" style="padding-left:1.1rem;">
          <li>Copy the markdown.</li>
          <li>Save as <code>.claude/skills/{slug}/SKILL.md</code> (project) or under <code>~/.claude/skills/</code> (everywhere).</li>
          <li>Claude Code loads it when the description matches{skill.invocation?.[0] ? <>, or on <code>{skill.invocation[0]}</code></> : null}.</li>
        </ol>
      </div>
    </ActionRail>
  </div>
</Site>
