---
import { marked } from "marked";
import catalog from "../../../../public/exports/catalog.json";

export function getStaticPaths() {
  return (catalog.atoms as any[])
    .filter((a: any) => a.type === "skill")
    .map((a: any) => ({
      params: { slug: a.id.replace("skill/", "") },
      props: { skill: a },
    }));
}

const { skill } = Astro.props;
const promptHtml = skill.system_prompt_fragment
  ? marked.parse(skill.system_prompt_fragment)
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={skill.description} />
    <title>{skill.name} · ai-atoms</title>
    <link rel="icon" type="image/svg+xml" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/favicon.svg" />
    <link rel="preconnect" href="https://brand-atoms.com" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/css/tokens.css" />
    <link rel="stylesheet" href="https://brand-atoms.com/dist/brands/atom-family/1.0.0/ui/atoms-catalog.css" />
    <style>
      body { min-height: 100vh; }
      .sidenav-wordmark { width: 140px; object-fit: contain; display: block; }

      .skill-hero {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 1.5rem;
      }
      .skill-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.5rem;
        line-height: 1.2;
      }
      .skill-description {
        font-size: 1rem;
        color: #475569;
        line-height: 1.6;
        max-width: 52rem;
        margin: 0 0 1rem;
      }
      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        font-size: 0.8rem;
        color: #64748b;
        align-items: center;
      }
      .meta-item { display: flex; gap: 0.375rem; align-items: center; }
      .meta-label { font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.68rem; }

      /* Invocation block */
      .invocation-block {
        background: #0f172a;
        border-radius: 0.5rem;
        padding: 0.875rem 1.125rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
        max-width: 44rem;
      }
      .inv-primary { font-family: monospace; font-size: 1rem; color: #a5f3fc; font-weight: 700; }
      .inv-variant { font-family: monospace; font-size: 0.85rem; color: #64748b; padding-left: 1rem; }

      /* Tags/domains */
      .tag-row { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 1.5rem; }
      .tag {
        font-size: 0.72rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        background: #f1f5f9;
        color: #475569;
      }
      .tag.domain { background: #ede9fe; color: #6d28d9; }

      /* Contract section */
      .section-heading {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #64748b;
        margin: 1.5rem 0 0.75rem;
      }
      .contract-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        max-width: 44rem;
        margin-bottom: 1.5rem;
      }
      .contract-table th {
        text-align: left;
        padding: 0.375rem 0.75rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
      }
      .contract-table td {
        padding: 0.5rem 0.75rem;
        border: 1px solid #e2e8f0;
        color: #1e293b;
        vertical-align: top;
      }
      .contract-table td code {
        background: #f1f5f9;
        padding: 0.1rem 0.3rem;
        border-radius: 0.2rem;
        font-size: 0.8em;
        color: #334155;
      }
      .optional { color: #94a3b8; font-size: 0.75em; }

      /* Markdown prose */
      .prompt-prose {
        color-scheme: light;
        background: #f8fafc;
        border-left: 3px solid #4f46e5;
        border-radius: 0 0.5rem 0.5rem 0;
        padding: 1.25rem 1.5rem;
        font-size: 0.875rem;
        line-height: 1.7;
        color: #1e293b !important;
        max-width: 52rem;
        overflow-x: auto;
      }
      .prompt-prose h1, .prompt-prose h2, .prompt-prose h3 {
        color: #0f172a !important;
        margin: 1.25rem 0 0.5rem;
        line-height: 1.3;
      }
      .prompt-prose h1 { font-size: 1.25rem; }
      .prompt-prose h2 { font-size: 1.05rem; }
      .prompt-prose h3 { font-size: 0.95rem; }
      .prompt-prose p { margin: 0.75rem 0; color: #1e293b !important; }
      .prompt-prose ul, .prompt-prose ol { padding-left: 1.5rem; margin: 0.5rem 0; }
      .prompt-prose li { margin: 0.25rem 0; color: #1e293b !important; }
      .prompt-prose code {
        background: #e2e8f0 !important;
        padding: 0.1rem 0.3rem;
        border-radius: 0.2rem;
        font-size: 0.85em;
        color: #1e3a5f !important;
      }
      /* Code blocks: dark bg with light text — explicit !important to defeat atoms-catalog.css */
      .prompt-prose pre {
        background: #1e293b !important;
        color: #e2e8f0 !important;
        padding: 1rem 1.25rem;
        border-radius: 0.375rem;
        overflow-x: auto;
        margin: 0.75rem 0;
        font-size: 0.8rem;
        line-height: 1.6;
      }
      .prompt-prose pre code {
        background: none !important;
        color: #e2e8f0 !important;
        padding: 0;
      }
      .prompt-prose table {
        border-collapse: collapse;
        width: 100%;
        margin: 0.75rem 0;
        font-size: 0.85em;
      }
      .prompt-prose table th, .prompt-prose table td {
        border: 1px solid #cbd5e1;
        padding: 0.375rem 0.625rem;
        text-align: left;
      }
      .prompt-prose table th { background: #f1f5f9; font-weight: 600; }
      .prompt-prose blockquote {
        border-left: 3px solid #94a3b8;
        padding-left: 1rem;
        margin: 0.75rem 0;
        color: #64748b;
        font-style: italic;
      }
      .prompt-prose a { color: #4f46e5; }
      .prompt-prose hr { border: none; border-top: 1px solid #e2e8f0; margin: 1rem 0; }

      .attribution {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e2e8f0;
        font-size: 0.78rem;
        color: #94a3b8;
      }
      .attribution a { color: #818cf8; }
    </style>
  </head>
  <body>
    <div class="shell">
      <main class="content" style="color-scheme:light;background:#ffffff;color:#1e293b;">
        <p style="margin-bottom: 1rem;"><a href="/atoms/skill/">← All skills</a></p>

        <div class="skill-hero">
          <h1 class="skill-title">{skill.name}</h1>
          <p class="skill-description">{skill.description}</p>
          <div class="meta-row">
            <span class="meta-item"><span class="meta-label">Class</span> skill</span>
            <span class="meta-item"><span class="meta-label">ID</span> <code style="font-size:0.8rem;background:#f1f5f9;padding:0.1rem 0.3rem;border-radius:0.2rem;">{skill.id}</code></span>
            <span class="meta-item"><span class="meta-label">Version</span> {skill.version}</span>
            {skill.lifecycle && <span class="meta-item"><span class="meta-label">Lifecycle</span> {skill.lifecycle}</span>}
            {skill.authored_by && <span class="meta-item"><span class="meta-label">Author</span> {skill.authored_by}</span>}
          </div>
        </div>

        {skill.invocation?.length > 0 && (
          <div class="invocation-block">
            <span class="inv-primary">{skill.invocation[0]}</span>
            {skill.invocation.slice(1).map((v: string) => (
              <span class="inv-variant">{v}</span>
            ))}
          </div>
        )}

        {(skill.applicable_domains?.length > 0 || skill.tags?.length > 0) && (
          <div class="tag-row">
            {skill.applicable_domains?.map((d: string) => <span class="tag domain">{d}</span>)}
            {skill.tags?.filter((t: string) => !skill.applicable_domains?.includes(t)).map((t: string) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )}

        {skill.invocation_contract && (
          <>
            {skill.invocation_contract.inputs?.length > 0 && (
              <>
                <div class="section-heading">Inputs</div>
                <table class="contract-table">
                  <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
                  <tbody>
                    {skill.invocation_contract.inputs.map((inp: any) => (
                      <tr>
                        <td><code>{inp.name}</code> {!inp.required && <span class="optional">optional</span>}</td>
                        <td><code>{inp.type}</code></td>
                        <td>{inp.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </>
            )}
            {skill.invocation_contract.outputs?.length > 0 && (
              <>
                <div class="section-heading">Outputs</div>
                <table class="contract-table">
                  <thead><tr><th>Name</th><th>Type</th><th>Description</th></tr></thead>
                  <tbody>
                    {skill.invocation_contract.outputs.map((out: any) => (
                      <tr>
                        <td><code>{out.name}</code></td>
                        <td><code>{out.type}</code></td>
                        <td>{out.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </>
            )}
            {skill.invocation_contract.side_effects?.length > 0 && (
              <>
                <div class="section-heading">Side effects</div>
                <ul style="font-size:0.85rem;color:#475569;padding-left:1.5rem;margin-bottom:1.5rem;">
                  {skill.invocation_contract.side_effects.map((e: string) => <li>{e}</li>)}
                </ul>
              </>
            )}
          </>
        )}

        {promptHtml && (
          <>
            <div class="section-heading">System prompt fragment</div>
            <div class="prompt-prose" set:html={promptHtml} />
          </>
        )}

        {(skill.authored_by || skill.source_url) && (
          <div class="attribution">
            {skill.authored_by && <>Attribution: <strong>{skill.authored_by}</strong>. </>}
            {skill.source_url && <><a href={skill.source_url} target="_blank" rel="noopener">View original source ↗</a>.</>}
            {' '}License: Apache-2.0 or as stated by the originating repository.
          </div>
        )}
      </main>

      <nav class="sidenav">
        <a class="brand" href="/">
          <img src="https://brand-atoms.com/dist/brands/atom-family/1.0.0/assets/atom-family-wordmark.png" alt="ATOMS" class="sidenav-wordmark" />
        </a>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/atoms/skill/" aria-current="page">Skills</a></li>
          <li><a href="/atoms/hook/">Hooks</a></li>
          <li><a href="/ai/index.json">AI</a></li>
          <li><a href="/builder/">Builder</a></li>
          <li><a href="https://github.com/convergent-systems-co/ai-atoms">GitHub ↗</a></li>
        </ul>
        <div class="aside-meta">
          <a class="meta-link" href="https://github.com/convergent-systems-co/ai-atoms">github ↗</a>
        </div>
      </nav>
    </div>
  </body>
</html>
